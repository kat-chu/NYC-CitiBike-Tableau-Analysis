      <aliases enabled='yes' />
      <column caption='Trip Duration (Minutes)' datatype='integer' name='[Calculation_5498684105843142657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [started_at], [ended_at])' />
      </column>
      <column caption='Hour of Day' datatype='integer' name='[Calculation_5498684105843970050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [started_at])' />
      </column>
      <column caption='Day of Week' datatype='string' name='[Calculation_5498684105844170755]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [started_at])' />
      </column>
