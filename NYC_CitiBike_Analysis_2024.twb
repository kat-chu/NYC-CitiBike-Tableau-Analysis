        <zone flipboard-zone-id='5' forceUpdate='true' h='38625' hidden='true' id='6' story-point-id='1' type-v2='text' w='48100' x='29700' y='28000'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Avenir' fontsize='20'>New York Citi Bike: Ridership Analysis January - March 2024. This analysis explores over 1.6 million rides to uncover two key phenomena: how members and casual riders use the system differently, and which stations and bike types are most popular.</run>
          </formatted-text>
